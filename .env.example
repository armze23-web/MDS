# Copy this file to .env and fill your real ZORT credentials.
ZORT_STORE_NAME=
ZORT_API_KEY=
ZORT_API_SECRET=

# Optional
ZORT_BASE_URL=https://open-api.zortout.com/v4
ZORT_DEFAULT_LIMIT=500
ZORT_SOURCE=zort

# Supabase upsert settings
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPSERT_ENABLED=true
SUPABASE_UPSERT_CHUNK_SIZE=500

# Cron job settings for npm run cron
CRON_TIMEZONE=Asia/Bangkok
CRON_RUN_ON_START=false

# Daily Summary Pipeline: runs every day at 00:01 and extracts T-1.
CRON_DAILY_SUMMARY_ENABLED=true
CRON_DAILY_SUMMARY_SCHEDULE=1 0 * * *
CRON_DAILY_SUMMARY_TASKS=orders,movement,summary

# Month-to-Date Pipeline: extracts from the 1st day of the current month through today.
CRON_MTD_ENABLED=true
CRON_MTD_SCHEDULE=10 0 * * *
CRON_MTD_TASKS=orders,movement,summary

# Monthly Closing Pipeline: runs on the 1st day at 00:30 and extracts the previous full month.
CRON_MONTHLY_CLOSING_ENABLED=true
CRON_MONTHLY_CLOSING_SCHEDULE=30 0 1 * *
CRON_MONTHLY_CLOSING_TASKS=orders,movement,summary
